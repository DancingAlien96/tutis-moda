# Puerto del API (Vite hace proxy de /api y /uploads hacia aquí)
API_PORT=4180
# Contraseña del panel de administrador (/admin)
ADMIN_PASSWORD=cambia-esta-clave
# Secreto para firmar las sesiones del administrador
SESSION_SECRET=pon-aqui-un-texto-largo-y-aleatorio
# Opcional: detrás de nginx (número de proxies)
# TRUST_PROXY=1
# Opcional: IPs o redes de la tienda que entran al admin sin esperas (separadas por coma)
# ADMIN_ALLOW_IPS=203.0.113.10,198.51.100.0/24
