{
  "name": "tutis-moda",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Tienda en línea de Tuti's Moda Colombiana — jeans colombianos",
  "scripts": {
    "dev": "concurrently -k -n api,web -c yellow,blue \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --watch --disable-warning=ExperimentalWarning server/index.js",
    "dev:web": "vite",
    "build": "vite build",
    "build:demo": "cross-env VITE_DEMO=1 VITE_BASE=/tutis-moda/ vite build",
    "start": "node --disable-warning=ExperimentalWarning server/index.js",
    "seed": "node --disable-warning=ExperimentalWarning server/seed.js --reset",
    "preview:demo": "cross-env VITE_BASE=/tutis-moda/ vite preview --port 5181 --strictPort"
  },
  "dependencies": {
    "express": "^4.21.2",
    "multer": "^1.4.5-lts.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-icons": "^5.7.0",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "vite": "^5.4.11"
  }
}
